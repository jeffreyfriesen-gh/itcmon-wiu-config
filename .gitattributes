# Hash-validated configuration files must not be rewritten by Git on Windows.
.gitattributes text eol=lf
itc-truck-mon.ps1 binary
wius/**/*.json binary
rrdata.json binary
profiles/**/*.json binary
channel-plans/**/*.json binary
receiver-profiles/**/*.json binary
recording-profiles/**/*.json binary
runtime/**/*.json binary
scripts/*.ps1 binary
scripts/*.cmd binary

# Human-authored files have explicit, predictable line endings.
manifest.json text eol=lf
README.md text eol=lf
observed-base-stations/* text eol=lf
